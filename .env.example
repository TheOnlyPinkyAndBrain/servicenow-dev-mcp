# ServiceNow instance URL (no trailing slash)
# Example: https://dev12345.service-now.com
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com

# Server mode: "debug" or "develop"
#   debug   — (default) Read-only. 88 tools for safe investigation and debugging.
#   develop — Read-write. 112 tools including create, update, and delete operations.
SERVICENOW_MODE=debug

# Auth method: "basic" | "bearer" | "oauth"  (default: basic)
SERVICENOW_AUTH_METHOD=basic

# --- basic (default) ---
# The user needs appropriate roles for the modules you want to access.
# For full access, use an admin account or a user with: admin, rest_api_explorer,
# web_service_admin, itil, catalog_admin, sn_appclient.app_client_company_installer
#
# NOTE: even with SERVICENOW_AUTH_METHOD=bearer or oauth, set these two if you
# want the background-script tool to work — it logs in via ServiceNow's UI
# (sys.scripts.do) which has no REST/OAuth/bearer-token equivalent.
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-password-here

# --- bearer ---
# ServiceNow has no GitHub-style long-lived personal access token. What this
# actually accepts is one of:
#   1. A ServiceNow-issued OAuth 2.0 access token -- the same kind the oauth
#      method below fetches automatically, just one you already obtained
#      yourself some other way (a running OAuth flow elsewhere, another
#      script/integration, etc).
#   2. An externally-issued OIDC/JWT token (e.g. from Azure AD) -- only valid
#      if your instance has Multi-Provider SSO / External OAuth configured to
#      trust that issuer for API calls. That's an instance-admin setting, not
#      default -- check with your ServiceNow admin before assuming it works.
# Either way, these tokens are typically short-lived (ServiceNow's default
# OAuth token TTL is often ~30 minutes) and this server does NOT refresh a
# manually-provided token the way the oauth method refreshes its own -- once
# it expires, every request fails until you paste in a new one.
# If you don't already have a token handed to you by some other system, use
# the oauth method below instead -- it fetches and refreshes automatically.
# SERVICENOW_ACCESS_TOKEN=your-access-token

# --- oauth ---
# Uses ServiceNow's own OAuth token endpoint (/oauth_token.do). Requires an
# OAuth application registered on the instance (System OAuth > Application
# Registry) to get a client ID/secret. Tokens are fetched, cached, and
# refreshed automatically.
# SERVICENOW_OAUTH_CLIENT_ID=your-client-id
# SERVICENOW_OAUTH_CLIENT_SECRET=your-client-secret
#
# Grant type: "password" (default) | "client_credentials"
#   password           — ties the token to a specific user's roles (needs the
#                         two fields below). Use this for most dev/admin work.
#   client_credentials — app-only token, no user context. Only works if your
#                         OAuth application is configured for it.
# SERVICENOW_OAUTH_GRANT_TYPE=password
# SERVICENOW_OAUTH_USERNAME=integration-user
# SERVICENOW_OAUTH_PASSWORD=integration-user-password
#
# Company/Microsoft SSO note: this server runs headless and cannot complete
# an interactive Azure AD login. If your instance enforces SSO for all users,
# either (a) use a ServiceNow integration/service account that is excluded
# from SSO enforcement with the oauth method above, or (b) if your instance
# has Multi-Provider SSO configured to accept externally-issued Azure AD
# tokens for API auth, fetch that token yourself (e.g. via MSAL client-
# credentials flow) and pass it in through SERVICENOW_AUTH_METHOD=bearer.
